# ══════════════════════════════════════════════════════════════════════════════
# GitHub2Course — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.
# ══════════════════════════════════════════════════════════════════════════════


# ─── Database (Supabase → PostgreSQL) ────────────────────────────────────────
#
# Phase 1: Supabase (free tier, 500 MB storage, 50k MAU)
# Phase 2: Amazon RDS PostgreSQL — only the two URLs below change.
#           The Prisma schema, client, and all application code stay identical.
#
# Supabase connection pooler (used by the app at runtime via pgBouncer)
# Find it at: Supabase dashboard → Settings → Database → Connection Pooling
DATABASE_URL="postgresql://postgres.YOUR_PROJECT_REF:[PASSWORD]@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Direct connection (used ONLY by Prisma migrations / prisma db push — NOT the app)
# Find it at: Supabase dashboard → Settings → Database → Connection string → URI
DIRECT_URL="postgresql://postgres.YOUR_PROJECT_REF:[PASSWORD]@aws-0-REGION.supabase.com:5432/postgres"

# ── Supabase client keys (optional — for Supabase Auth / Storage / Realtime) ──
# If you use Supabase only as a PostgreSQL host (current setup), these are NOT required.
# Add them later if you want Supabase client-side features.
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
# Keep this server-side only — never expose in client bundles
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# ── Storage optimisation notes ────────────────────────────────────────────────
# The Prisma schema is already optimised for minimal storage:
#   - @db.Text for large strings (no fixed VARCHAR overhead)
#   - JSON columns store structured data compactly (no extra tables needed)
#   - Indexed columns: analysisStatus, generationStatus, userId — fast queries
#   - AI output cached per-repo — never re-generated, written once
#   - Generated course content shared across all learners (no duplication)
# Estimated per-repo storage: ~50–200 KB (schema + lessons + quizzes)
# Supabase free tier (500 MB) supports ~2,500–10,000 repos before upgrade


# ─── Authentication (NextAuth v5 / Auth.js) ───────────────────────────────────
# GitHub OAuth App — create at https://github.com/settings/developers
# Callback URL (dev):  http://localhost:3000/api/auth/callback/github
# Callback URL (prod): https://yourdomain.com/api/auth/callback/github
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# GitHub personal access token for cloning repos (higher rate limits)
# Scopes: public_repo (public repos only) or repo (includes private repos)
GITHUB_TOKEN=""

# NextAuth secret — generate with: openssl rand -base64 32
AUTH_SECRET=""

# Your production domain (no trailing slash)
NEXTAUTH_URL="http://localhost:3000"


# ─── Admin Panel ─────────────────────────────────────────────────────────────
# Password for the admin panel at /admin/login
# Authorised emails are hard-coded in lib/admin/auth.ts
ADMIN_PASSWORD="clIG08**"

# Secret for signing admin session tokens (HMAC-SHA256)
# Generate with: openssl rand -base64 32
ADMIN_JWT_SECRET="your-admin-jwt-secret-change-this-in-production"


# ─── Redis / Queue (BullMQ) ────────────────────────────────────────────────────
# Only needed in production — development uses PIPELINE_MODE=inline (no Redis)
REDIS_URL="redis://localhost:6379"

# Set to "inline" locally so generation runs in-process (no worker process needed)
# Set to "queue" in production so a BullMQ worker handles the heavy AI generation
PIPELINE_MODE="inline"


# ─── AI Key Rotation Pool ─────────────────────────────────────────────────────
#
# The app automatically rotates through Gemini keys 1→6 when a key hits its
# daily quota (1M free tokens/day per Google account). When all 6 are exhausted,
# it falls back to OpenRouter (paid, no daily cap).
#
# Total free capacity: 6 × 1M = 6 MILLION tokens/day from Gemini alone.
# That's roughly 25–30 medium repos per day for free.
#
# ── How to get free Gemini keys ──
#   1. Sign in to https://aistudio.google.com with a Google account
#   2. Click "Get API key" → "Create API key"
#   3. Copy the key (starts with "AI..." or "AQ...")
#   4. Repeat for each of your 6 Google accounts → paste below as KEY_1..KEY_6
#
# ── Rotation behaviour ──
#   - On HTTP 429 / RESOURCE_EXHAUSTED → current key marked exhausted until midnight UTC
#   - The SAME request is retried immediately on the next key (no error, no lost content)
#   - When all Gemini keys are exhausted → OpenRouter takes over (OPENROUTER_API_KEY)
#   - At midnight UTC Gemini keys reset → Gemini is used again from KEY_1
#
AI_API_KEY_1="your-gemini-key-account-1"
AI_API_KEY_2="your-gemini-key-account-2"
AI_API_KEY_3="your-gemini-key-account-3"
AI_API_KEY_4="your-gemini-key-account-4"
AI_API_KEY_5="your-gemini-key-account-5"
AI_API_KEY_6="your-gemini-key-account-6"

# Gemini model — gemini-2.5-flash is free, fast, and great at structured JSON
AI_MODEL="gemini-2.5-flash"

# ── OpenRouter backup (paid) ──
# Create key at: https://openrouter.ai → Keys → Create key
# Pricing: depends on model. google/gemini-2.5-flash ≈ $0.10/MTok input, $0.40/MTok output
# Used ONLY when all 6 Gemini keys are exhausted for the day.
OPENROUTER_API_KEY="sk-or-your-openrouter-key"
OPENROUTER_MODEL="google/gemini-2.5-flash"

# ── DeepSeek V3 (optional second backup) ──
# Activate at: https://platform.deepseek.com → API Keys → Create
# Pricing: ~$0.14/MTok input, $0.28/MTok output (~$0.002–0.010 per repo)
DEEPSEEK_API_KEY=""

# ── Legacy single-key mode (still works if numbered keys above are not set) ──
# AI_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai/"
# AI_API_KEY="your-single-gemini-key"
# AI_MODEL="gemini-2.5-flash"

# ── Self-hosted GPU options ──
# Vast.ai GPU: AI_BASE_URL="http://<IP>:<PORT>/v1"   AI_API_KEY_1="ollama"
# Local Ollama: AI_BASE_URL="http://localhost:11434/v1" AI_API_KEY_1="ollama"


# ─── Monitoring & Observability ───────────────────────────────────────────────
# Better Stack (uptime monitoring + log drain) — https://betterstack.com
BETTER_STACK_SOURCE_TOKEN=""

# Sentry error tracking — https://sentry.io
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""

# PostHog product analytics — https://posthog.com
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://app.posthog.com"

# Google Analytics 4
NEXT_PUBLIC_GA_ID=""


# ─── Cloudflare Turnstile (bot protection on import form) ─────────────────────
# Create a widget at: https://dash.cloudflare.com → Turnstile
# Leave blank to skip verification in development (verify() returns true when unconfigured)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""


# ─── Clerk (optional alternative auth layer) ──────────────────────────────────
# Only needed if you want Clerk instead of NextAuth. When set, Clerk wraps
# the middleware. Dev-login at /api/dev-login remains available regardless.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""


# ─── Storage ─────────────────────────────────────────────────────────────────
# Temporary directory where repos are cloned during analysis.
# The clone is deleted after AI generation completes (only the DB record remains).
CLONE_BASE_DIR="/tmp/gitpath/repos"


# ─── App ─────────────────────────────────────────────────────────────────────
NODE_ENV="development"
