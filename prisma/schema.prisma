// GitHub2Course Database Schema
// PostgreSQL via Supabase + Prisma ORM

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Authentication ────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  githubId      String?   @unique
  githubUsername String?  @unique
  githubToken   String?   // Encrypted OAuth token for private repo access

  xp            Int       @default(0)
  level         Int       @default(1)
  streak        Int       @default(0)
  vibeScore     Int       @default(0)   // 0-∞; displayed 0-100 normalised
  lastActiveAt  DateTime?
  isFakeUser    Boolean   @default(false) // leaderboard seed users

  deletionRequestedAt DateTime?  // set when user requests deletion; null = no pending deletion

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  enrollments   Enrollment[]
  progress      UserProgress[]
  quizAttempts  QuizAttempt[]
  userBadges    UserBadge[]
  conceptMastery ConceptMastery[]
  tutorMessages TutorMessage[]
  repositories  Repository[]

  @@index([githubUsername])
  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ─── Repository & Analysis ─────────────────────────────────────────────────────

model Repository {
  id              String            @id @default(cuid())
  owner           String            // github org/user
  name            String            // repo name
  fullName        String            @unique // "owner/name"
  description     String?
  githubUrl       String
  defaultBranch   String            @default("main")
  isPrivate       Boolean           @default(false)
  stars           Int               @default(0)
  language        String?           // primary language
  topics          String[]          // github topics

  // Owner — the user who imported this repo; only they can see it
  userId          String?
  user            User?             @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Analysis state
  cloneStatus     CloneStatus       @default(PENDING)
  analysisStatus  AnalysisStatus    @default(PENDING)
  clonedAt        DateTime?
  analyzedAt      DateTime?
  clonePath       String?           // local clone path (temp)

  // Detected metadata (populated during static analysis)
  detectedLanguages String[]
  detectedFrameworks String[]
  packageManager   String?
  nodeVersion      String?
  hasTests         Boolean          @default(false)
  hasDocker        Boolean          @default(false)
  hasCI            Boolean          @default(false)
  commitCount      Int?
  contributors     Int?
  totalFiles       Int?
  totalLines       Int?

  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  graph           RepositoryGraph?
  courses         Course[]
  aiJobs          AIJob[]

  @@index([fullName])
  @@index([analysisStatus])
  @@index([userId])
  @@map("repositories")
}

model RepositoryGraph {
  id             String     @id @default(cuid())
  repositoryId   String     @unique
  version        Int        @default(1)

  // Structured JSON graph produced by static analysis — no AI
  folders        Json       // FolderNode[]
  files          Json       // FileNode[]
  dependencies   Json       // DependencyEdge[]
  components     Json       // ComponentNode[]
  apiRoutes      Json       // APIRouteNode[]
  dbSchema       Json?      // detected DB tables/models
  envVars        Json       // EnvVarNode[]
  importGraph    Json       // { [filePath]: string[] }
  conceptTags    String[]   // ["react-context", "server-components", ...]
  architectureType String?  // "monolith" | "monorepo" | "microservices"
  complexity     Int        @default(0) // 1-10 score

  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  repository     Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@map("repository_graphs")
}

// ─── Course & Lesson ──────────────────────────────────────────────────────────

model Course {
  id              String       @id @default(cuid())
  repositoryId    String
  title           String
  description     String       @db.Text
  thumbnail       String?
  difficulty      Difficulty
  estimatedHours  Float
  language        String?
  framework       String?
  prerequisites   String[]     // concept slugs required before starting
  learningGoals   String[]
  tags            String[]

  // Generation state
  generationStatus GenerationStatus @default(PENDING)
  generatedAt      DateTime?
  generationError  String?

  isPublished     Boolean      @default(false)
  publishedAt     DateTime?
  totalLessons    Int          @default(0)
  totalXP         Int          @default(0)

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  repository      Repository   @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  modules         Module[]
  enrollments     Enrollment[]
  learningPaths   LearningPath[]

  @@index([repositoryId])
  @@index([generationStatus])
  @@index([isPublished])
  @@map("courses")
}

model Module {
  id           String   @id @default(cuid())
  courseId     String
  order        Int
  title        String
  description  String   @db.Text
  conceptSlug  String   // e.g. "react-context", "nextjs-routing"
  prerequisites String[] // concept slugs

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  course       Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons      Lesson[]
  progress     UserProgress[]

  @@unique([courseId, order])
  @@index([courseId])
  @@map("modules")
}

model Lesson {
  id                 String   @id @default(cuid())
  moduleId           String
  order              Int
  title              String
  description        String   @db.Text
  difficulty         Difficulty
  estimatedMinutes   Int

  // Rich lesson content (AI-generated once, cached forever)
  explanation        String   @db.Text
  codeSnippets       Json     // CodeSnippet[]
  flowDiagram        String?  @db.Text  // Mermaid diagram syntax
  realWorldAnalogy   String   @db.Text
  summary            String   @db.Text
  practiceTask       String   @db.Text
  keyTakeaways       String[]
  architecturalDecisions Json? // ArchDecision[]
  bestPractices      String[]
  commonMistakes     String[]

  // Source references
  relatedFiles       String[] // paths within the repository
  conceptsCovered    String[] // concept slugs

  xpReward           Int      @default(10)

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  module             Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  quizzes            Quiz[]
  progress           UserProgress[]

  @@unique([moduleId, order])
  @@index([moduleId])
  @@map("lessons")
}

// ─── Concept Graph ────────────────────────────────────────────────────────────

model Concept {
  id           String   @id @default(cuid())
  slug         String   @unique  // "react-context", "jwt-auth"
  name         String
  category     String            // "frontend" | "backend" | "database" | "devops" | "language"
  description  String   @db.Text
  difficulty   Difficulty
  prerequisites String[]         // concept slugs

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  mastery      ConceptMastery[]

  @@index([slug])
  @@index([category])
  @@map("concepts")
}

model ConceptMastery {
  id           String   @id @default(cuid())
  userId       String
  conceptSlug  String
  level        Int      @default(0)  // 0=unknown, 1=introduced, 2=practiced, 3=mastered
  lastSeenAt   DateTime?

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  concept      Concept  @relation(fields: [conceptSlug], references: [slug], onDelete: Cascade)

  @@unique([userId, conceptSlug])
  @@index([userId])
  @@map("concept_mastery")
}

// ─── Learning & Progress ──────────────────────────────────────────────────────

model Enrollment {
  id          String    @id @default(cuid())
  userId      String
  courseId    String
  enrolledAt  DateTime  @default(now())
  completedAt DateTime?
  lastAccessAt DateTime?
  progressPct  Float    @default(0)  // 0-100

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  course      Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
  @@map("enrollments")
}

model UserProgress {
  id          String        @id @default(cuid())
  userId      String
  lessonId    String?
  moduleId    String?
  status      ProgressStatus @default(NOT_STARTED)
  completedAt DateTime?
  xpEarned    Int           @default(0)
  timeSpentMs Int           @default(0)

  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson      Lesson?       @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  module      Module?       @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([userId])
  @@index([lessonId])
  @@map("user_progress")
}

// ─── Quiz Engine ──────────────────────────────────────────────────────────────

model Quiz {
  id           String       @id @default(cuid())
  lessonId     String
  type         QuizType
  question     String       @db.Text
  options      Json?        // string[] for multiple-choice
  correctAnswer String      @db.Text
  explanation  String       @db.Text
  codeContext  String?      @db.Text
  difficulty   Difficulty
  xpReward     Int          @default(5)

  lesson       Lesson       @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  attempts     QuizAttempt[]

  @@index([lessonId])
  @@map("quizzes")
}

model QuizAttempt {
  id          String   @id @default(cuid())
  userId      String
  quizId      String
  answer      String   @db.Text
  isCorrect   Boolean
  xpEarned    Int      @default(0)
  attemptedAt DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  quiz        Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([quizId])
  @@map("quiz_attempts")
}

// ─── AI Tutor ─────────────────────────────────────────────────────────────────

model TutorSession {
  id           String         @id @default(cuid())
  userId       String
  repositoryId String
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  messages     TutorMessage[]

  @@index([userId, repositoryId])
  @@map("tutor_sessions")
}

model TutorMessage {
  id          String       @id @default(cuid())
  sessionId   String
  userId      String
  role        MessageRole
  content     String       @db.Text
  citations   Json?        // FileReference[] — which files in the repo were cited
  createdAt   DateTime     @default(now())

  session     TutorSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("tutor_messages")
}

// ─── Gamification ─────────────────────────────────────────────────────────────

model Badge {
  id          String      @id @default(cuid())
  slug        String      @unique
  name        String
  description String
  icon        String      // emoji or icon name
  xpThreshold Int?        // awarded when user reaches this XP
  condition   Json?       // { type: "streak"|"lessons"|"repos", value: number }

  userBadges  UserBadge[]

  @@map("badges")
}

model UserBadge {
  id        String   @id @default(cuid())
  userId    String
  badgeId   String
  awardedAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge     Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
  @@index([userId])
  @@map("user_badges")
}

model LearningPath {
  id          String   @id @default(cuid())
  courseId    String
  lessonOrder Json     // string[] of lessonIds in adaptive order
  generatedAt DateTime @default(now())

  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId])
  @@map("learning_paths")
}

// ─── Job Queue (persisted state) ──────────────────────────────────────────────

model AIJob {
  id            String    @id @default(cuid())
  repositoryId  String
  type          AIJobType
  status        JobStatus @default(QUEUED)
  bullmqJobId   String?   // BullMQ job ID for tracking
  priority      Int       @default(5)
  retryCount    Int       @default(0)
  maxRetries    Int       @default(3)
  errorMessage  String?
  resultSummary Json?     // metadata about what was generated
  startedAt     DateTime?
  completedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  repository    Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@index([repositoryId])
  @@index([status])
  @@index([type])
  @@map("ai_jobs")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum CloneStatus {
  PENDING
  CLONING
  CLONED
  FAILED
}

enum AnalysisStatus {
  PENDING
  ANALYZING
  ANALYZED
  FAILED
}

enum GenerationStatus {
  PENDING
  GENERATING
  COMPLETED
  FAILED
  PARTIAL
}

enum Difficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

enum ProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  SKIPPED
}

enum QuizType {
  MULTIPLE_CHOICE
  CODE_COMPLETION
  DEBUGGING
  ARCHITECTURE
  FREE_RESPONSE
}

enum AIJobType {
  GENERATE_COURSE
  GENERATE_LESSON
  GENERATE_PREREQUISITES
  GENERATE_QUIZ
}

enum JobStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}
